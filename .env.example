# Copiar a `.env`. Todo tiene valor por defecto: sin este archivo,
# `docker compose up --build` funciona igual.
#
# Las mismas variables sirven dentro y fuera de contenedores. Los puertos
# publicados los lee Docker Compose; el proxy de Vite y los E2E los leen de
# aquí cuando se trabaja con `npm run dev`.

# --- PostgreSQL ---
POSTGRES_USER=gopass
POSTGRES_PASSWORD=gopass
POSTGRES_DB=gopass_tasks

# Puerto publicado en el host. 5433 y no 5432 a propósito:
# un 5432 ocupado por otra instancia local es la causa número uno
# de "no me arranca".
POSTGRES_PORT=5433

# --- API ---
# Puerto publicado en el host. Dentro de la red de Compose la API siempre
# escucha en el 3000, así que cambiar esto no afecta a nginx.
API_PORT=3000
NODE_ENV=development

# Datos de demostración al arrancar el contenedor. Por defecto activo, para
# que la aplicación abra con datos y no en pantalla vacía (RF-16).
# Ponerlo en `false` levanta el sistema con la base migrada y vacía.
SEED_ON_START=true

# Fuera de Docker apunta al puerto publicado; dentro de Compose
# el servicio se resuelve por nombre (db:5432).
DATABASE_URL=postgres://gopass:gopass@localhost:5433/gopass_tasks

# --- Web ---
# Puerto publicado en el host, y también el que usa `npm run dev`.
WEB_PORT=5173
